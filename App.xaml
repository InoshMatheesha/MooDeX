<Application x:Class="MooDeX_New_Version_1._0.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="DeepPurple" SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

           <!-- Ultra Thin Modern ScrollBar -->
<Style x:Key="ModernScrollBar" TargetType="{x:Type ScrollBar}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>

    <Style.Triggers>

        <!-- VERTICAL -->
        <Trigger Property="Orientation" Value="Vertical">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent" Width="4">

                            <Track x:Name="PART_Track"
                                   Width="4"
                                   IsDirectionReversed="True">

                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0"
                                                  Focusable="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"/>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0"
                                                  Focusable="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb x:Name="Thumb"
                                           Width="3"
                                           Background="#80FFFFFF">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="3"
                                                        CornerRadius="2"
                                                        Background="{TemplateBinding Background}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                            </Track>

                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb"
                                        Property="Background"
                                        Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Trigger>

        <!-- HORIZONTAL -->
        <Trigger Property="Orientation" Value="Horizontal">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent" Height="4">

                            <Track x:Name="PART_Track"
                                   Height="4">

                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0"
                                                  Focusable="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"/>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0"
                                                  Focusable="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb x:Name="Thumb"
                                           Height="3"
                                           Background="#80FFFFFF">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Height="3"
                                                        CornerRadius="2"
                                                        Background="{TemplateBinding Background}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                            </Track>

                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb"
                                        Property="Background"
                                        Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Trigger>

    </Style.Triggers>
</Style>

            <!-- Make it the default ScrollBar Style -->
            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBar}"/>

            <!-- Override Material Design ScrollBar key to apply to their controls -->
            <Style x:Key="MaterialDesignScrollBar" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBar}"/>

            <!-- Force all ScrollViewers to style their child ScrollBars with ModernScrollBar -->
            <Style TargetType="{x:Type ScrollViewer}">
                <Style.Resources>
                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBar}"/>
                </Style.Resources>
            </Style>

            <!-- Modern Hover Effect for Cards -->
            <Style x:Key="ModernHoverCardStyle" TargetType="{x:Type materialDesign:Card}">
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                    </Setter.Value>
                </Setter>
                <!-- Use MaterialDesign's high-performance optimized elevation -->
                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1"/>
                <Style.Resources>
                    <QuadraticEase x:Key="SmoothEase" EasingMode="EaseOut"/>
                </Style.Resources>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <!-- Elevate card on hover using built-in optimized elevation -->
                        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp4"/>
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1.03" Duration="0:0:0.2" EasingFunction="{StaticResource SmoothEase}"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1.03" Duration="0:0:0.2" EasingFunction="{StaticResource SmoothEase}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1.0" Duration="0:0:0.2" EasingFunction="{StaticResource SmoothEase}"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1.0" Duration="0:0:0.2" EasingFunction="{StaticResource SmoothEase}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Override MaterialDesignOutlinedTextBox to keep text/hint readable when focused -->
            <Style x:Key="MaterialDesignOutlinedTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#1A1C24"/>
                <Setter Property="BorderBrush" Value="#444455"/>
                <Setter Property="CaretBrush" Value="White"/>
                <Setter Property="materialDesign:HintAssist.Foreground" Value="#B0B0B0"/>
                <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="22.5"/>
                <Style.Triggers>
                    <Trigger Property="IsFocused" Value="True">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#1A1C24"/>
                        <Setter Property="BorderBrush" Value="#BB86FC"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#80BB86FC"/>
                    </Trigger>
                </Style.Triggers>
            </Style>


            <!-- Global Primary Color Override for High Contrast Focus States -->
            <SolidColorBrush x:Key="MaterialDesign.Brush.Primary" Color="#BB86FC" />
            <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#BB86FC" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
