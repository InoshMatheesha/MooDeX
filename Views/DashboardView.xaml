<UserControl x:Class="MooDeX_New_Version_1._0.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:MooDeX_New_Version_1._0.Helpers"
             Background="Transparent"
             Foreground="White">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title -->
                <RowDefinition Height="Auto"/> <!-- Top Bar (4 status counts) -->
                <RowDefinition Height="Auto"/> <!-- Mid Row (Stats & GOAT) -->
                <RowDefinition Height="*"/>    <!-- Bottom Row (Most Played Games) -->
            </Grid.RowDefinitions>
            
            <!-- Row 0: Title & Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Welcome back! Here's your gaming overview." FontSize="14" Foreground="#A0A0A0" Margin="0,5,0,0"/>
            </StackPanel>
            
            <!-- Row 1: Status Counts Top Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Playing Card -->
                <materialDesign:Card Grid.Column="0" Margin="0,0,8,0" UniformCornerRadius="16" Background="#1E1E2E" BorderBrush="#4CAF50" BorderThickness="1">
                    <StackPanel Margin="15,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PLAYING" FontSize="11" FontWeight="Bold" Foreground="#4CAF50"/>
                                <TextBlock Text="{Binding PlayingCount}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="1" Kind="PlayCircleOutline" Width="28" Height="28" Foreground="#4CAF50" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Completed Card -->
                <materialDesign:Card Grid.Column="1" Margin="8,0,8,0" UniformCornerRadius="16" Background="#1E1E2E" BorderBrush="#FFD700" BorderThickness="1">
                    <StackPanel Margin="15,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="COMPLETED" FontSize="11" FontWeight="Bold" Foreground="#FFD700"/>
                                <TextBlock Text="{Binding CompletedCount}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="1" Kind="TrophyOutline" Width="28" Height="28" Foreground="#FFD700" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Like to Play Card -->
                <materialDesign:Card Grid.Column="2" Margin="8,0,8,0" UniformCornerRadius="16" Background="#1E1E2E" BorderBrush="#BB86FC" BorderThickness="1">
                    <StackPanel Margin="15,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="LIKE TO PLAY" FontSize="11" FontWeight="Bold" Foreground="#BB86FC"/>
                                <TextBlock Text="{Binding LikeToPlayCount}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="1" Kind="HeartOutline" Width="28" Height="28" Foreground="#BB86FC" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Stopped Card -->
                <materialDesign:Card Grid.Column="3" Margin="8,0,0,0" UniformCornerRadius="16" Background="#1E1E2E" BorderBrush="#F44336" BorderThickness="1">
                    <StackPanel Margin="15,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="STOPPED" FontSize="11" FontWeight="Bold" Foreground="#F44336"/>
                                <TextBlock Text="{Binding StoppedCount}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="1" Kind="StopCircleOutline" Width="28" Height="28" Foreground="#F44336" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
            
            <!-- Row 2: Stats Summary and My GOAT Game Card -->
            <Grid Grid.Row="2" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>
                
                <!-- Total Games -->
                <materialDesign:Card Grid.Column="0" Margin="0,0,10,0" UniformCornerRadius="16" Background="#282A3A" VerticalAlignment="Stretch">
                    <StackPanel Margin="20" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#3D405B" CornerRadius="8" Padding="10">
                                <materialDesign:PackIcon Kind="GamepadVariant" Width="20" Height="20" Foreground="#BB86FC"/>
                            </Border>
                            <TextBlock Text="Total Games" FontSize="14" FontWeight="SemiBold" Foreground="#B0B0B0" VerticalAlignment="Center" Margin="15,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalGames}" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,15,0,0"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Playtime Card -->
                <materialDesign:Card Grid.Column="1" Margin="10,0,10,0" UniformCornerRadius="16" Background="#282A3A" VerticalAlignment="Stretch">
                    <StackPanel Margin="20" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#3D405B" CornerRadius="8" Padding="10">
                                <materialDesign:PackIcon Kind="ClockOutline" Width="20" Height="20" Foreground="#2196F3"/>
                            </Border>
                            <TextBlock Text="Playtime" FontSize="14" FontWeight="SemiBold" Foreground="#B0B0B0" VerticalAlignment="Center" Margin="15,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalPlaytimeFormatted}" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,15,0,0"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- My GOAT Game Card -->
                <materialDesign:Card Grid.Column="2" Margin="10,0,0,0" UniformCornerRadius="16" Background="#282A3A" ClipToBounds="True" Height="170">
                    <Grid>
                        <!-- Cover Art background if available -->
                        <Image helpers:ImageHelper.SourceUrl="{Binding GoatGame.CoverUrl}" Stretch="UniformToFill" Opacity="0.80"
                               Visibility="{Binding ShowGoatDetails, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Border Visibility="{Binding ShowGoatDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- Overlay gradient -->
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#991E1E2E" Offset="0"/>
                                    <GradientStop Color="#B3282A3A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: Header & Action Buttons -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="StarCircle" Width="16" Height="16" Foreground="#FFD700" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="MY G.O.A.T. GAME" FontSize="11" FontWeight="Bold" Foreground="#FFD700" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Edit/Change Button (Shown when displaying details) -->
                                <Button Grid.Column="1" 
                                        Command="{Binding ChangeGoatCommand}" 
                                        Visibility="{Binding ShowGoatDetails, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Style="{StaticResource MaterialDesignIconButton}" 
                                        Width="26" Height="26" Padding="0" Margin="0" 
                                        ToolTip="Change GOAT Game"
                                        Foreground="#FFD700">
                                    <materialDesign:PackIcon Kind="Pencil" Width="14" Height="14"/>
                                </Button>

                                <!-- Cancel Button (Shown when selecting and GoatGame is already selected) -->
                                <Button Grid.Column="1" 
                                        Command="{Binding CancelChangeGoatCommand}" 
                                        Visibility="{Binding ShowCancelGoatButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Style="{StaticResource MaterialDesignIconButton}" 
                                        Width="26" Height="26" Padding="0" Margin="0" 
                                        ToolTip="Cancel Change">
                                    <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="White"/>
                                </Button>
                            </Grid>

                            <!-- Row 1: Content -->
                            <!-- Case A: Selecting Mode (ComboBox) -->
                            <Grid Grid.Row="1" Visibility="{Binding IsSelectingGoat, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="Choose your greatest of all time game:" FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding UniqueGames}"
                                              SelectedItem="{Binding GoatGame}"
                                              DisplayMemberPath="Title"
                                              materialDesign:HintAssist.Hint="Select your GOAT Game"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              Foreground="White"
                                              BorderBrush="#444"
                                              Height="45"
                                              Padding="12,0"
                                              VerticalContentAlignment="Center"
                                              FontSize="13"/>
                                </StackPanel>
                            </Grid>

                            <!-- Case B: Details Mode -->
                            <Grid Grid.Row="1" Visibility="{Binding ShowGoatDetails, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="{Binding GoatGame.Title}" 
                                           FontSize="18" FontWeight="Bold" Foreground="White" 
                                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ClockOutline" Width="14" Height="14" Foreground="#FFD700" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding GoatGame.PlaytimeFormatted, StringFormat='{}{0} played'}" FontSize="13" Foreground="#FFD700" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </materialDesign:Card>
            </Grid>
            
            <!-- Row 3: Top 3 Most Played Games -->
            <StackPanel Grid.Row="3">
                <TextBlock Text="Most Played Games" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Top 1st Card -->
                    <materialDesign:Card Grid.Column="0" Margin="0,0,10,0" UniformCornerRadius="16" Background="#1E1E1E" Height="220" ClipToBounds="True">
                        <Grid>
                            <!-- Wallpaper background -->
                            <Image helpers:ImageHelper.SourceUrl="{Binding TopGame1.CoverUrl}" Stretch="UniformToFill" Opacity="0.75"/>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1A000000" Offset="0"/>
                                        <GradientStop Color="#4D000000" Offset="0.5"/>
                                        <GradientStop Color="#99000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Grid Margin="20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Rank Badge -->
                                <Border Grid.Row="0" HorizontalAlignment="Left" Background="#CCFFD700" CornerRadius="6" Padding="8,4">
                                    <TextBlock Text="1st PLACE" FontSize="11" FontWeight="Bold" Foreground="Black"/>
                                </Border>

                                <!-- Title and Playtime (at bottom) -->
                                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding TopGame1.Title, FallbackValue='Slot Vacant'}" FontSize="18" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Visibility="{Binding HasTopGame1, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <!-- Playtime -->
                                        <materialDesign:PackIcon Kind="ClockOutline" Width="14" Height="14" Foreground="#BB86FC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding TopGame1.PlaytimeFormatted}" FontSize="13" FontWeight="SemiBold" Foreground="#BB86FC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Top 2nd Card -->
                    <materialDesign:Card Grid.Column="1" Margin="10,0,10,0" UniformCornerRadius="16" Background="#1E1E1E" Height="220" ClipToBounds="True">
                        <Grid>
                            <!-- Wallpaper background -->
                            <Image helpers:ImageHelper.SourceUrl="{Binding TopGame2.CoverUrl}" Stretch="UniformToFill" Opacity="0.75"/>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1A000000" Offset="0"/>
                                        <GradientStop Color="#4D000000" Offset="0.5"/>
                                        <GradientStop Color="#99000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Grid Margin="20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Rank Badge -->
                                <Border Grid.Row="0" HorizontalAlignment="Left" Background="#CCC0C0C0" CornerRadius="6" Padding="8,4">
                                    <TextBlock Text="2nd PLACE" FontSize="11" FontWeight="Bold" Foreground="Black"/>
                                </Border>

                                <!-- Title and Playtime (at bottom) -->
                                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding TopGame2.Title, FallbackValue='Slot Vacant'}" FontSize="18" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Visibility="{Binding HasTopGame2, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <!-- Playtime -->
                                        <materialDesign:PackIcon Kind="ClockOutline" Width="14" Height="14" Foreground="#BB86FC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding TopGame2.PlaytimeFormatted}" FontSize="13" FontWeight="SemiBold" Foreground="#BB86FC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Top 3rd Card -->
                    <materialDesign:Card Grid.Column="2" Margin="10,0,0,0" UniformCornerRadius="16" Background="#1E1E1E" Height="220" ClipToBounds="True">
                        <Grid>
                            <!-- Wallpaper background -->
                            <Image helpers:ImageHelper.SourceUrl="{Binding TopGame3.CoverUrl}" Stretch="UniformToFill" Opacity="0.75"/>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1A000000" Offset="0"/>
                                        <GradientStop Color="#4D000000" Offset="0.5"/>
                                        <GradientStop Color="#99000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Grid Margin="20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Rank Badge -->
                                <Border Grid.Row="0" HorizontalAlignment="Left" Background="#CCCD7F32" CornerRadius="6" Padding="8,4">
                                    <TextBlock Text="3rd PLACE" FontSize="11" FontWeight="Bold" Foreground="Black"/>
                                </Border>

                                <!-- Title and Playtime (at bottom) -->
                                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding TopGame3.Title, FallbackValue='Slot Vacant'}" FontSize="18" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Visibility="{Binding HasTopGame3, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <!-- Playtime -->
                                        <materialDesign:PackIcon Kind="ClockOutline" Width="14" Height="14" Foreground="#BB86FC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding TopGame3.PlaytimeFormatted}" FontSize="13" FontWeight="SemiBold" Foreground="#BB86FC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>