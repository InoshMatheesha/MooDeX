<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="MooDeX_New_Version_1._0.Views.DiscoverView"
             xmlns:helpers="clr-namespace:MooDeX_New_Version_1._0.Helpers"
             Background="Transparent"
             Foreground="White">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
<!-- Header Grid: Title and Search bar on the top-right -->
<Grid Grid.Row="0" Margin="0,0,0,25">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <materialDesign:PackIcon Kind="CompassOutline"
                                 Width="32" Height="32"
                                 Foreground="White"
                                 VerticalAlignment="Center"
                                 Margin="0,0,12,0"/>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Discover Games"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"/>
            <TextBlock Text="Find and add new titles to your library "
                       FontSize="14"
                       Foreground="#A0A0A0"
                       Margin="0,4,0,0"/>
        </StackPanel>
    </StackPanel>

    <!-- Modern rounded search bar -->
    <Border Grid.Column="1"
            Width="340"
            Height="48"
            VerticalAlignment="Center"
            CornerRadius="24"
            Background="#1F1F1F"
            BorderBrush="#3A3A3A"
            BorderThickness="1"
            Padding="18,0,16,0">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="14"
                     Foreground="White"
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalContentAlignment="Center"
                     Padding="0"
                     materialDesign:HintAssist.Hint="Search for a game title..." 
                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>

            <materialDesign:PackIcon Grid.Column="1"
                                     Kind="Magnify"
                                     Width="20"
                                     Height="20"
                                     Foreground="#9A9A9A"
                                     VerticalAlignment="Center"
                                     Margin="12,0,0,0"/>
        </Grid>
    </Border>
</Grid>

        <!-- Tabs Selector (Trending, Upcoming, Popular) -->
        <ListBox Grid.Row="1" SelectedValue="{Binding SelectedTab, Mode=TwoWay}"
                 SelectedValuePath="Tag"
                 Background="Transparent" BorderThickness="0" Margin="0,0,0,25">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,15,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="TabBorder" Padding="18,10" CornerRadius="20" Background="#1E1E1E" BorderThickness="1.5" BorderBrush="#333">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#2D2040"/>
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#BB86FC"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#2D2D2D"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBoxItem Tag="Trending">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Fire" Width="18" Height="18" Foreground="#B3B3B3" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Trending" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>

            <ListBoxItem Tag="Upcoming">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CalendarClock" Width="18" Height="18" Foreground="#B3B3B3" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Upcoming" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>

            <ListBoxItem Tag="Popular">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Crown" Width="18" Height="18" Foreground="#B3B3B3" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Popular" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
        </ListBox>

        <Grid Grid.Row="2">
            <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top" Panel.ZIndex="10"
                          Background="Transparent" Foreground="#BB86FC"
                          Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding SearchResults}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card Width="300" Margin="10,10,20,20" UniformCornerRadius="16" Background="#1E1E1E"
                                             Style="{StaticResource ModernHoverCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="170"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Cover Image -->
                                <Border Grid.Row="0" CornerRadius="16,16,0,0" ClipToBounds="True">
                                    <Grid>
                                        <Image helpers:ImageHelper.SourceUrl="{Binding CoverUrl}" Stretch="UniformToFill" />
                                        <Border VerticalAlignment="Bottom" Height="60">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="Transparent" Offset="0"/>
                                                    <GradientStop Color="#CC1E1E1E" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>

                                <materialDesign:PackIcon Grid.Row="0" Kind="ImageOffOutline" Width="50" Height="50" 
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3"
                                                         Visibility="Collapsed"/>

                                <!-- Info panel -->
                                <Grid Grid.Row="1" Margin="20,15">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Title -->
                                    <TextBlock Grid.Row="0" Text="{Binding Title}"
                                               FontWeight="Bold" FontSize="16"
                                               TextWrapping="WrapWithOverflow" MaxHeight="45"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Title}" Foreground="White" Margin="0,0,0,5"/>

                                    <!-- Release Date -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                                        <materialDesign:PackIcon Kind="CalendarOutline" Width="12" Height="12"
                                                                 Foreground="#8A8A8A" VerticalAlignment="Center"
                                                                 Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding ReleaseDate, StringFormat='Released: {0}'}"
                                                   FontSize="12" Foreground="#8A8A8A" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ReleaseDate}" Value="">
                                                            <Setter Property="Text" Value="Released: N/A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ReleaseDate}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="Released: N/A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Row 2 Actions -->
                                    <Grid Grid.Row="2" VerticalAlignment="Bottom">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left side: Status indicator / library presence status -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock FontSize="13" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Not in Library"/>
                                                        <Setter Property="Foreground" Value="#8A8A8A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                                <Setter Property="Text" Value="Added to Library"/>
                                                                <Setter Property="Foreground" Value="#2196F3"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Add Button on the right -->
                                        <Button Grid.Column="1" Command="{Binding DataContext.AddToLibraryCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Width="34" Height="34" Padding="0"
                                                VerticalAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                                    <!-- Default: Not added (Green +) -->
                                                    <Setter Property="Background" Value="#4CAF50"/>
                                                    <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                    <Setter Property="ToolTip" Value="Add to Library"/>
                                                    <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="17"/>
                                                    <Setter Property="Content">
                                                        <Setter.Value>
                                                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Foreground="White"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                            <!-- Added: (Blue Tick) -->
                                                            <Setter Property="Background" Value="#2196F3"/>
                                                            <Setter Property="BorderBrush" Value="#2196F3"/>
                                                            <Setter Property="ToolTip" Value="Added to Library"/>
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                            <Setter Property="Content">
                                                                <Setter.Value>
                                                                    <materialDesign:PackIcon Kind="Check" Width="18" Height="18" Foreground="White"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
