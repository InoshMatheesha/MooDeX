<UserControl x:Class="MooDeX_New_Version_1._0.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:MooDeX_New_Version_1._0.Helpers"
             Background="Transparent"
             Foreground="White"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         Outer DialogHost: Edit-game dialog
    ═══════════════════════════════════════════════════════════════ -->
    <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}" CloseOnClickAway="True" DialogContentUniformCornerRadius="16" materialDesign:TransitionAssist.DisableTransitions="True">
        <materialDesign:DialogHost.DialogContent>
            <Border Padding="30" Background="#282A3A" CornerRadius="16" Width="460">
                <Border.Resources>
                    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary" Color="#BB86FC" />
                    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#BB86FC" />
                </Border.Resources>
                <StackPanel>
                    <TextBlock Text="Edit Game Details" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding SelectedGame.Title}" FontSize="15" FontWeight="SemiBold"
                               Foreground="#A0A0A0" Margin="0,0,0,25" TextWrapping="Wrap"/>

                    <!-- Status -->
                    <TextBlock Text="Game Status" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
                    <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedGame.Status}"
                               Style="{StaticResource MaterialDesignOutlinedComboBox}"
                               Foreground="White" Height="45" Margin="0,0,0,25"
                               Padding="12,0"
                               VerticalContentAlignment="Center"/>

                    <!-- Rating Title and Description -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Your Rating" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedGame.RatingDescription}" Foreground="#BB86FC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Slider & Numeric Badge -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Slider for fine-tuning rating (1 to 10, snaps to 0.5) -->
                        <Slider Grid.Column="0" Value="{Binding SelectedGame.Rating, Mode=TwoWay}"
                                Minimum="1" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                Foreground="#BB86FC" Height="30" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        
                        <!-- Numerical display badge (e.g. 8.5/10) -->
                        <Border Grid.Column="1" Background="#1E1E2E" CornerRadius="8" Padding="10,6" BorderBrush="#BB86FC" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Star" Foreground="#FFD700" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding SelectedGame.Rating, StringFormat={}{0:0.#}}" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="/10" Foreground="#8A8A8A" FontSize="11" VerticalAlignment="Center" Margin="1,1,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Quick Preset Chips -->
                    <TextBlock Text="Quick Presets" Foreground="#A0A0A0" FontSize="12" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,25">
                        <WrapPanel.Resources>
                            <Style x:Key="PresetChipStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                <Setter Property="Foreground" Value="#BB86FC"/>
                                <Setter Property="BorderBrush" Value="#444"/>
                                <Setter Property="Height" Value="32"/>
                                <Setter Property="Margin" Value="0,0,8,8"/>
                                <Setter Property="Padding" Value="12,0"/>
                                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="16"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </WrapPanel.Resources>
                        
                        <Button Style="{StaticResource PresetChipStyle}" Content="1.0" Command="{Binding SetRatingCommand}" CommandParameter="1.0"/>
                        <Button Style="{StaticResource PresetChipStyle}" Content="5.0" Command="{Binding SetRatingCommand}" CommandParameter="5.0"/>
                        <Button Style="{StaticResource PresetChipStyle}" Content="5.5" Command="{Binding SetRatingCommand}" CommandParameter="5.5"/>
                        <Button Style="{StaticResource PresetChipStyle}" Content="7.5" Command="{Binding SetRatingCommand}" CommandParameter="7.5"/>
                        <Button Style="{StaticResource PresetChipStyle}" Content="8.5" Command="{Binding SetRatingCommand}" CommandParameter="8.5"/>
                        <Button Style="{StaticResource PresetChipStyle}" Content="9.0" Command="{Binding SetRatingCommand}" CommandParameter="9.0"/>
                        <Button Style="{StaticResource PresetChipStyle}" Content="10.0" Command="{Binding SetRatingCommand}" CommandParameter="10.0"/>
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CloseDialogCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#A0A0A0" BorderBrush="#444" Margin="0,0,15,0"
                                Height="40" Width="40" Padding="0" ToolTip="Cancel">
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Command="{Binding SaveGameCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#4CAF50" BorderBrush="#4CAF50" Foreground="White"
                                Height="40" Width="40" Padding="0" ToolTip="Save Changes">
                            <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </materialDesign:DialogHost.DialogContent>

        <!-- ═══════════════════════════════════════════════════════════
             Inner DialogHost: Add-to-Library search dialog
        ═══════════════════════════════════════════════════════════════ -->
        <materialDesign:DialogHost IsOpen="{Binding IsAddDialogOpen}" CloseOnClickAway="True" DialogContentUniformCornerRadius="16" materialDesign:TransitionAssist.DisableTransitions="True">
            <materialDesign:DialogHost.DialogContent>
                <Border Padding="30" Background="#282A3A" CornerRadius="16" Width="460" MaxHeight="520">
                    <Border.Resources>
                        <SolidColorBrush x:Key="MaterialDesign.Brush.Primary" Color="#BB86FC" />
                        <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#BB86FC" />
                    </Border.Resources>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="Add to My Library" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Search the RAWG database and add a title" FontSize="13" Foreground="#A0A0A0" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Search bar -->
                        <Grid Grid.Row="1" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding AddSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Search for a game title…"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Foreground="White" Height="45" FontSize="14" Padding="12,0"
                                     VerticalContentAlignment="Center"/>
                            <materialDesign:PackIcon Grid.Column="1" Kind="Magnify"
                                                     Width="22" Height="22" VerticalAlignment="Center"
                                                     Foreground="#A0A0A0"
                                                     Visibility="{Binding IsAddSearchRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="22" Height="22"
                                         VerticalAlignment="Center" Style="{StaticResource MaterialDesignCircularProgressBar}"
                                         Visibility="{Binding IsAddSearchRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>

                        <!-- Search results list -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="300">
                            <ItemsControl ItemsSource="{Binding AddSearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Background="#1E1E1E" CornerRadius="10" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="54"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Thumbnail -->
                                                <Border Grid.Column="0" CornerRadius="6" ClipToBounds="True"
                                                        Width="50" Height="50" Margin="0,0,12,0">
                                                    <Image helpers:ImageHelper.SourceUrl="{Binding CoverUrl}" Stretch="UniformToFill"/>
                                                </Border>

                                                <!-- Title -->
                                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="White" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>

                                                <!-- + Add button -->
                                                <Button Grid.Column="2"
                                                        Command="{Binding DataContext.AddSearchResultToLibraryCommand, RelativeSource={RelativeSource AncestorType=materialDesign:DialogHost}}"
                                                        CommandParameter="{Binding}"
                                                        Width="34" Height="34" Padding="0"
                                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                                        Background="#4CAF50" BorderBrush="#4CAF50"
                                                        materialDesign:ButtonAssist.CornerRadius="17"
                                                        ToolTip="Add to My Library">
                                                    <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Foreground="White"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Footer -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                            <Button Content="Done" Command="{Binding CloseAddDialogCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#4CAF50" BorderBrush="#4CAF50" Foreground="White"
                                    Height="40" materialDesign:ButtonAssist.CornerRadius="8" Padding="24,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </materialDesign:DialogHost.DialogContent>

            <!-- ═══════════════════════════════════════════════════
                 Main content
            ═══════════════════════════════════════════════════ -->
            <Grid Margin="30">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header row -->
                <Grid Grid.Row="0" Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Bookshelf" Width="32" Height="32" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="My Library" FontSize="28" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Games you discovered and added from the RAWG database"
                                       FontSize="14" Foreground="#A0A0A0" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                  <!-- Header Actions (Search + Sort + Add Button) -->
<StackPanel Grid.Column="1"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Margin="0,10,0,6">

    <!-- Modern Search Bar -->
    <Border Width="220"
            Height="45"
            CornerRadius="22"
            Background="#1E1E2E"
            BorderBrush="#A970FF"
            BorderThickness="1.5"
            Margin="0,0,15,0">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <materialDesign:PackIcon Grid.Column="0"
                                     Kind="Magnify"
                                     Width="18"
                                     Height="18"
                                     Foreground="#A0A0A0"
                                     Margin="15,0,8,0"
                                     VerticalAlignment="Center"/>

            <TextBox Grid.Column="1"
                     Text="{Binding LibrarySearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Search library…"
                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     FontSize="14"
                     FontWeight="SemiBold"
                     VerticalContentAlignment="Center"
                     Padding="0,0,15,0"/>
        </Grid>
    </Border>

    <!-- Modern Sort Dropdown -->
    <Border Width="180"
            Height="45"
            CornerRadius="22"
            Background="#1E1E2E"
            BorderBrush="#A970FF"
            BorderThickness="1.5"
            Margin="0,0,15,0">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <materialDesign:PackIcon Grid.Column="0"
                                     Kind="SortVariant"
                                     Width="18"
                                     Height="18"
                                     Foreground="#A970FF"
                                     Margin="15,0,10,0"
                                     VerticalAlignment="Center"/>

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding SortOptions}"
                      SelectedItem="{Binding SelectedSortOption}"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="White"
                      FontSize="14"
                      FontWeight="SemiBold"
                      VerticalContentAlignment="Center"
                      Padding="0,0,20,0"
                      materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" />
        </Grid>
    </Border>

    <!-- Modern Add Button -->
    <Button Command="{Binding OpenAddDialogCommand}"
            Width="52"
            Height="52"
            Background="#4CAF50"
            BorderBrush="#4CAF50"
            Style="{StaticResource MaterialDesignRaisedButton}"
            materialDesign:ButtonAssist.CornerRadius="26"
            ToolTip="Add Game">

        <materialDesign:PackIcon Kind="Plus"
                                 Width="26"
                                 Height="26"
                                 Foreground="White"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
    </Button>

</StackPanel>
                </Grid>

                <!-- Empty State Panel -->
                <Grid Grid.Row="1" Visibility="Collapsed" x:Name="EmptyStatePanel">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MyGames.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0">
                        <Border Width="80" Height="80" CornerRadius="40" Background="#1E1F29" Margin="0,0,0,20">
                            <materialDesign:PackIcon Kind="GamepadVariantOutline" Width="40" Height="40" Foreground="#8A8A8A" 
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Your Library is Empty" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Explore and add games from the RAWG database." FontSize="14" Foreground="#8A8A8A" HorizontalAlignment="Center" Margin="0,0,0,25"/>
                        <Button Content="Discover Games" Command="{Binding DataContext.NavigateToDiscoverCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource MaterialDesignRaisedButton}" Background="#BB86FC" BorderBrush="#BB86FC" Foreground="Black" FontWeight="Bold"
                                Height="40" Padding="25,0" materialDesign:ButtonAssist.CornerRadius="20"/>
                    </StackPanel>
                </Grid>

                <!-- Game card grid -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MyGames.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl ItemsSource="{Binding MyGames}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Card Width="300" Margin="10,10,20,20" Style="{StaticResource ModernHoverCardStyle}"
                                                     UniformCornerRadius="16" Background="#1E1E1E">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="170"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Cover Image -->
                                        <Border Grid.Row="0" CornerRadius="16,16,0,0" ClipToBounds="True">
                                            <Grid>
                                                <Image helpers:ImageHelper.SourceUrl="{Binding CoverUrl}" Stretch="UniformToFill"/>
                                                <materialDesign:PackIcon Kind="ImageOffOutline"
                                                                         Width="50" Height="50"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Opacity="0.3" Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>

                                        <!-- Info panel -->
                                        <Grid Grid.Row="1" Margin="20,15">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{Binding Title}"
                                                       FontWeight="Bold" FontSize="16"
                                                       TextWrapping="WrapWithOverflow" MaxHeight="45"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Title}" Foreground="White" Margin="0,0,0,5"/>

                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlaytimeFormatted}" Value="0m">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <materialDesign:PackIcon Kind="ClockOutline" Width="14" Height="14"
                                                                         Foreground="#B0B0B0" VerticalAlignment="Center"
                                                                         Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding PlaytimeFormatted}"
                                                           FontSize="12" Foreground="#B0B0B0" VerticalAlignment="Center"/>
                                            </StackPanel>


                                            <Grid Grid.Row="2" VerticalAlignment="Bottom">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                                    <TextBlock Text="{Binding Status}" FontSize="14" FontWeight="Bold"
                                                               Foreground="#4CAF50" Margin="0,0,0,5"/>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="Star" Foreground="#FFD700"
                                                                                 Width="14" Height="14"
                                                                                 VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                         <TextBlock Text="{Binding Rating, StringFormat='{}{0:0.#}'}" Foreground="#FFD700"
                                                                    FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                         <TextBlock Text="/10" Foreground="#707070" FontSize="11"
                                                                    VerticalAlignment="Center" Margin="2,1,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Edit & Delete icon buttons -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                    <Button Command="{Binding DataContext.EditGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                                            Width="34" Height="34" Padding="0"
                                                            BorderBrush="#333" Foreground="#B0B0B0"
                                                            ToolTip="Edit Details" Margin="0,0,8,0"
                                                            materialDesign:ButtonAssist.CornerRadius="17">
                                                        <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16"/>
                                                    </Button>
                                                    <Button Command="{Binding DataContext.DeleteGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                                            Width="34" Height="34" Padding="0"
                                                            BorderBrush="#333" Foreground="#F44336"
                                                            ToolTip="Remove Game"
                                                            materialDesign:ButtonAssist.CornerRadius="17">
                                                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </materialDesign:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </materialDesign:DialogHost>
    </materialDesign:DialogHost>
</UserControl>