<UserControl x:Class="MooDeX_New_Version_1._0.Views.MyGamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:MooDeX_New_Version_1._0.Helpers"
             Background="Transparent"
             Foreground="White"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}" CloseOnClickAway="True" DialogContentUniformCornerRadius="16" materialDesign:TransitionAssist.DisableTransitions="True">
        <materialDesign:DialogHost.DialogContent>
            <!-- ── Add / Edit Popup Form ───────────────────────────────── -->
            <Border Padding="30" Background="#282A3A" CornerRadius="16" Width="480">
                <Border.Resources>
                    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary" Color="#BB86FC" />
                    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#BB86FC" />
                </Border.Resources>
                <StackPanel>
                    <!-- Dynamic dialog title -->
                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Edit Game &amp; Cover"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAddMode}" Value="True">
                                        <Setter Property="Text" Value="Match Game &amp; Cover"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock FontSize="13" Foreground="#A0A0A0" Margin="0,0,0,20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Change executable path or rematch it with rawg.io database"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAddMode}" Value="True">
                                        <Setter Property="Text" Value="Match local game executable with rawg.io database to retrieve cover art"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Executable File (.exe) -->
                    <TextBlock Text="Executable File (.exe)" Foreground="White" FontSize="14" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewExePath}"
                                 materialDesign:HintAssist.Hint="Select the game executable"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Foreground="White" Margin="0,0,10,0"
                                 Height="45" FontSize="14" Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="True"/>
                        <Button Grid.Column="1" Command="{Binding BrowseExeCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Height="45" Width="45" Padding="0"
                                ToolTip="Browse Executable">
                            <materialDesign:PackIcon Kind="FolderOpenOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Search Box for Matcher -->
                    <TextBlock Text="Search Game Database" Foreground="White" FontSize="14" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Search for a game title..."
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Foreground="White" Margin="0,0,10,0"
                                 Height="45" FontSize="14" Padding="12,0"
                                 VerticalContentAlignment="Center"/>
                        <Grid Grid.Column="1" Width="38" Height="38" VerticalAlignment="Center">
                            <!-- Spinner -->
                            <ProgressBar IsIndeterminate="True" Width="22" Height="22"
                                         Style="{StaticResource MaterialDesignCircularProgressBar}"
                                         Visibility="{Binding IsSearchRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <!-- Search Icon -->
                            <materialDesign:PackIcon Kind="Magnify" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A0A0A0">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSearchRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Grid>
                    </Grid>

                    <!-- Matching Results -->
                    <TextBlock Text="Select Matching Game" Foreground="White" FontSize="14" Margin="0,0,0,8"/>
                    <Border Background="#1A1C24" CornerRadius="10" Padding="5" Height="240" Margin="0,0,0,20">
                        <Grid>
                            <!-- List of matches -->
                            <ListBox ItemsSource="{Binding MatchedGames}"
                                     SelectedItem="{Binding SelectedMatch}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <EventSetter Event="MouseDoubleClick" Handler="OnListBoxItemDoubleClick"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder" Background="#242635" CornerRadius="8" BorderThickness="1.5" BorderBrush="Transparent" Padding="8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="46"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Thumbnail cover -->
                                                            <Border Grid.Column="0" CornerRadius="6" ClipToBounds="True" Width="40" Height="40" Margin="0,0,10,0">
                                                                <Grid>
                                                                    <Image helpers:ImageHelper.SourceUrl="{Binding CoverUrl}" Stretch="UniformToFill"/>
                                                                    <!-- Placeholder if cover is empty -->
                                                                    <materialDesign:PackIcon Kind="ImageOffOutline" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3">
                                                                        <materialDesign:PackIcon.Style>
                                                                            <Style TargetType="materialDesign:PackIcon">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding CoverUrl}" Value="">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </materialDesign:PackIcon.Style>
                                                                    </materialDesign:PackIcon>
                                                                </Grid>
                                                            </Border>

                                                            <!-- Game Title -->
                                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                            <!-- Checkmark check if selected -->
                                                            <materialDesign:PackIcon x:Name="CheckIcon" Grid.Column="2" Kind="CheckCircle" Width="18" Height="18" Foreground="#2196F3" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,6,0"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#2196F3"/>
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#2E3A59"/>
                                                            <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#32354A"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <!-- No Matches Warning Message -->
                            <TextBlock Text="No matching games found. Search above or enter details below."
                                       Foreground="#A0A0A0" FontSize="13" FontStyle="Italic"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15"
                                       Visibility="{Binding ShowNoMatchesMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Border>

                    <!-- Game Name Input (Editable) -->
                    <TextBlock Text="Game Title (Editable)" Foreground="White" FontSize="14" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding NewGameName, UpdateSourceTrigger=PropertyChanged}"
                              materialDesign:HintAssist.Hint="Type custom game title"
                              Style="{StaticResource MaterialDesignOutlinedTextBox}"
                              Foreground="White" Margin="0,0,0,25"
                              Height="45" FontSize="14" Padding="12,0"
                              VerticalContentAlignment="Center"/>

                    <!-- Dialog footer -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CloseDialogCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#A0A0A0" BorderBrush="#444" Margin="0,0,15,0"
                                Height="40" Width="40" Padding="0" ToolTip="Cancel">
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Command="{Binding SaveGameCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#4CAF50" BorderBrush="#4CAF50" Foreground="White"
                                Height="40" Width="40" Padding="0" ToolTip="Save">
                            <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </materialDesign:DialogHost.DialogContent>

        <!-- ═════════════════════════════════════════════
             Main page content
         ═════════════════════════════════════════════ -->
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header row -->
            <Grid Grid.Row="0" Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="FolderPlayOutline" Width="32" Height="32" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PC Games" FontSize="28" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Manually imported local games with executable paths"
                                   FontSize="14" Foreground="#A0A0A0"/>
                    </StackPanel>
                </StackPanel>
                <!-- Header Actions (Sort + Add Button) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,6">

                    <!-- Modern Sort Dropdown -->
                    <Border Width="176"
                            Height="44"
                            CornerRadius="22"
                            Background="#1E1E2E"
                            BorderBrush="#A970FF"
                            BorderThickness="1.5"
                            Margin="0,0,15,0">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Grid.Column="0"
                                                     Kind="SortVariant"
                                                     Width="18"
                                                     Height="18"
                                                     Foreground="#A970FF"
                                                     Margin="15,0,10,0"
                                                     VerticalAlignment="Center"/>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding SortOptions}"
                                      SelectedItem="{Binding SelectedSortOption}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Foreground="White"
                                      FontSize="14"
                                      FontWeight="SemiBold"
                                      VerticalContentAlignment="Center"
                                      Padding="0,0,20,0"
                                      materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" />
                        </Grid>
                    </Border>

                    <!-- Modern Add Button -->
                    <Button Command="{Binding OpenAddDialogCommand}"
                            Width="52"
                            Height="52"
                            Background="#2c0d6aff"
                            BorderBrush="#2c0d6aff"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="26"
                            ToolTip="Add Game">

                        <materialDesign:PackIcon Kind="Plus"
                                                 Width="26"
                                                 Height="26"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Button>

                </StackPanel>
            </Grid>

            <!-- Empty State Panel -->
            <Grid Grid.Row="1" Visibility="Collapsed" x:Name="EmptyStatePanel">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding InstalledGames.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50,0,0">
                    <Border Width="80" Height="80" CornerRadius="40" Background="#1E1F29" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="FolderPlayOutline" Width="40" Height="40" Foreground="#8A8A8A" 
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No local PC games added yet" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Import executable files from your PC to track and launch them." FontSize="14" Foreground="#8A8A8A" HorizontalAlignment="Center" Margin="0,0,0,25"/>
                    <Button Content="Import a Game" Command="{Binding OpenAddDialogCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" Background="#2196F3" BorderBrush="#2196F3" Foreground="White" FontWeight="Bold"
                            Height="40" Padding="25,0" materialDesign:ButtonAssist.CornerRadius="20"/>
                </StackPanel>
            </Grid>

            <!-- Game cards -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding InstalledGames.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding InstalledGames}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Width="300" Margin="10,10,20,20" Style="{StaticResource ModernHoverCardStyle}"
                                                 UniformCornerRadius="16" Background="#1E1E1E">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="160"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Cover -->
                                    <Border Grid.Row="0" CornerRadius="16,16,0,0" ClipToBounds="True">
                                        <Grid>
                                            <Image helpers:ImageHelper.SourceUrl="{Binding CoverUrl}" Stretch="UniformToFill"/>
                                            <materialDesign:PackIcon Kind="MonitorScreenshot"
                                                                     Width="60" Height="60"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"
                                                                     Opacity="0.3" Visibility="Collapsed"/>
                                            <Border Background="#33000000"/>
                                        </Grid>
                                    </Border>

                                    <!-- Playtime badge -->
                                    <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="10" Background="#CC282A3A" CornerRadius="6" Padding="8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ClockOutline" Width="14" Height="14"
                                                                     Foreground="#B0B0B0" VerticalAlignment="Center"
                                                                     Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding PlaytimeFormatted}"
                                                       FontSize="12" FontWeight="Bold" Foreground="White"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Info panel -->
                                    <Grid Grid.Row="1" Margin="15">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                           FontSize="16" FontWeight="Bold" Foreground="White" MaxWidth="195"/>
                                                <TextBlock Text="{Binding ReleaseDate, StringFormat=' ({0})'}" 
                                                           FontSize="11" Foreground="#A0A0A0" VerticalAlignment="Bottom" Margin="4,0,0,2">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ReleaseDate}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ReleaseDate}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                        </StackPanel>

                                        <!-- Action buttons (circular, icon-only) -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <!-- Edit Path -->
                                            <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Background="Transparent" Foreground="#B0B0B0"
                                                    BorderBrush="#444"
                                                    Margin="0,0,8,0" materialDesign:ButtonAssist.CornerRadius="15"
                                                    Height="30" Width="30" Padding="0" ToolTip="Edit Game &amp; Matcher">
                                                <materialDesign:PackIcon Kind="PencilOutline" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                            <!-- Play -->
                                            <Button Command="{Binding DataContext.PlayGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                                    Background="#2196F3" BorderBrush="#2196F3"
                                                    Margin="0,0,8,0" materialDesign:ButtonAssist.CornerRadius="15"
                                                    Height="30" Width="30" Padding="0" ToolTip="Launch Game">
                                                <materialDesign:PackIcon Kind="Play" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                            </Button>
                                            <!-- Remove -->
                                            <Button Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Background="Transparent" Foreground="#F44336"
                                                    BorderBrush="#40F44336"
                                                    materialDesign:ButtonAssist.CornerRadius="15"
                                                    Height="30" Width="30" Padding="0" ToolTip="Remove Game">
                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </materialDesign:DialogHost>
</UserControl>
