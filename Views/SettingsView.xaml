<UserControl x:Class="MooDeX_New_Version_1._0.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:MooDeX_New_Version_1._0.Helpers"
             Background="Transparent"
             Foreground="White">

    <!-- Value converters used by the Application Updates section -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <helpers:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,30">
            <materialDesign:PackIcon Kind="CogOutline" Width="32" Height="32" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Configure system startup, tray integration, and preferences" FontSize="14" Foreground="#A0A0A0" Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                
                <!-- System Configuration Section -->
                <materialDesign:Card UniformCornerRadius="16" Background="#1E1E1E" Padding="25" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <materialDesign:PackIcon Kind="Monitor" Width="22" Height="22" Foreground="#BB86FC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="System Integration" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Toggle Startup -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Launch MooDeX on Startup" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Automatically start MooDeX when you log into Windows." FontSize="13" Foreground="#8A8A8A" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="#2A2A2A" Margin="0,15"/>

                        <!-- Toggle Minimize to Tray -->
                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Minimize to System Tray" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Keep the app running in the background when minimized or closed." FontSize="13" Foreground="#8A8A8A" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="#2A2A2A" Margin="0,15"/>

                        <!-- Toggle Start Minimized -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Start Minimized" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Start the app minimized to the system tray on Windows startup." FontSize="13" Foreground="#8A8A8A" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding LaunchMinimized, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Application Updates Section -->
                <materialDesign:Card UniformCornerRadius="16" Background="#1E1E1E" Padding="25" Margin="0,0,0,20">
                    <StackPanel>
                        <!-- Section Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <materialDesign:PackIcon Kind="Update" Width="22" Height="22" Foreground="#BB86FC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Application Updates" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Update Row: Description + Button -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Check for Updates" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Check if a newer version of MooDeX is available for download." FontSize="13" Foreground="#8A8A8A" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Check for Updates Button with optional loading spinner -->
                            <Button Grid.Column="1"
                                    Command="{Binding CheckForUpdatesCommand}"
                                    VerticalAlignment="Center"
                                    Padding="18,8"
                                    FontSize="13">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Setter Property="Background" Value="#BB86FC"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10"/>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Spinner: visible only while checking -->
                                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                 Width="16" Height="16"
                                                 IsIndeterminate="True"
                                                 Foreground="White"
                                                 Margin="0,0,8,0"
                                                 Visibility="{Binding IsCheckingForUpdates, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <materialDesign:PackIcon Kind="CloudDownloadOutline"
                                                             Width="18" Height="18"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0"
                                                             Visibility="{Binding IsCheckingForUpdates, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="Check for Updates" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Status Text (e.g., "You are using the latest version." or error messages) -->
                        <TextBlock Text="{Binding UpdateStatusText}"
                                   FontSize="13"
                                   Foreground="#8A8A8A"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding UpdateStatusText, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer (About Section) -->
        <Border Grid.Row="2" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="MooDeX" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="The ultimate local and library game manager launcher." FontSize="13" Foreground="#8A8A8A" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Version 1.1" FontSize="13" FontWeight="SemiBold" Foreground="#BB86FC" HorizontalAlignment="Right"/>
                    <TextBlock Text="Powered by RAWG API database" FontSize="11" Foreground="#666666" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
