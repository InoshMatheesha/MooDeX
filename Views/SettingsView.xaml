<UserControl x:Class="MooDeX_New_Version_1._0.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:MooDeX_New_Version_1._0.Helpers"
             Background="Transparent"
             Foreground="White">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <helpers:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter"/>

        <!-- Row style for each setting item -->
        <Style x:Key="SettingRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>

        <!-- Section label style -->
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#7C6FCD"/>
            <Setter Property="Margin" Value="0,28,0,12"/>
        </Style>

        <!-- Setting title style -->
        <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E8E8F0"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- Setting description style -->
        <Style x:Key="SettingDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#6B6B8A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Thin separator -->
        <Style x:Key="RowSeparatorStyle" TargetType="Separator">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Height" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="40,36,40,20">
            <StackPanel HorizontalAlignment="Stretch">

                <!-- Page title -->
                <TextBlock Text="Settings"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,6"/>

                <!-- ══════════════════════════════
                     SECTION: BEHAVIOUR
                ══════════════════════════════ -->
                <TextBlock Text="BEHAVIOUR" Style="{StaticResource SectionLabelStyle}"/>

                <!-- Minimize to Tray on Close -->
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,14,20,14">
                        <TextBlock Text="Minimize to Tray on Close"
                                   Style="{StaticResource SettingTitleStyle}"/>
                        <TextBlock Text="When enabled, clicking X hides MooDeX to the system tray instead of quitting."
                                   Style="{StaticResource SettingDescStyle}"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="1"
                                  IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  VerticalAlignment="Center"/>
                </Grid>
                <Separator Style="{StaticResource RowSeparatorStyle}"/>

                <!-- Launch at Windows Startup -->
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,14,20,14">
                        <TextBlock Text="Launch at Windows Startup"
                                   Style="{StaticResource SettingTitleStyle}"/>
                        <TextBlock Text="MooDeX will start minimized in the background when you log in."
                                   Style="{StaticResource SettingDescStyle}"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="1"
                                  IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  VerticalAlignment="Center"/>
                </Grid>
                <Separator Style="{StaticResource RowSeparatorStyle}"/>

                <!-- Launch Minimized -->
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,14,20,14">
                        <TextBlock Text="Launch Minimized"
                                   Style="{StaticResource SettingTitleStyle}"/>
                        <TextBlock Text="When opened, MooDeX will start minimized to the system tray."
                                   Style="{StaticResource SettingDescStyle}"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="1"
                                  IsChecked="{Binding LaunchMinimized, Mode=TwoWay}"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  VerticalAlignment="Center"/>
                </Grid>

                <!-- ══════════════════════════════
                     SECTION: UPDATES
                ══════════════════════════════ -->
                <TextBlock Text="UPDATES" Style="{StaticResource SectionLabelStyle}"/>

                <!-- Check for Updates -->
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,14,20,14">
                        <TextBlock Text="Check for Updates"
                                   Style="{StaticResource SettingTitleStyle}"/>
                        <TextBlock Text="Check if a newer version of MooDeX is available."
                                   Style="{StaticResource SettingDescStyle}"/>
                        <!-- Status text shown inline -->
                        <TextBlock Text="{Binding UpdateStatusText}"
                                   FontSize="12"
                                   Foreground="#7C6FCD"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding UpdateStatusText, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding CheckForUpdatesCommand}"
                            VerticalAlignment="Center"
                            Padding="16,8"
                            FontSize="12"
                            FontWeight="SemiBold">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                <Setter Property="BorderBrush" Value="#2A2A3E"/>
                                <Setter Property="Foreground" Value="#A0A0C0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#7C6FCD"/>
                                        <Setter Property="Foreground" Value="#BB86FC"/>
                                        <Setter Property="Background" Value="#12100E"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                         Width="13" Height="13"
                                         IsIndeterminate="True"
                                         Foreground="#7C6FCD"
                                         Margin="0,0,8,0"
                                         Visibility="{Binding IsCheckingForUpdates, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <materialDesign:PackIcon Kind="CloudDownloadOutline"
                                                     Width="15" Height="15"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0"
                                                     Visibility="{Binding IsCheckingForUpdates, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            <TextBlock Text="Check for Updates" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <Separator Style="{StaticResource RowSeparatorStyle}"/>

                <!-- ══════════════════════════════
                     SECTION: ABOUT
                ══════════════════════════════ -->
                <TextBlock Text="ABOUT" Style="{StaticResource SectionLabelStyle}"/>

                <!-- GitHub row -->
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,14,20,14">
                        <TextBlock Text="Source Code on GitHub"
                                   Style="{StaticResource SettingTitleStyle}"/>
                        <TextBlock Style="{StaticResource SettingDescStyle}">
                            <Run Text="View, star, or contribute at "/>
                            <Hyperlink NavigateUri="https://github.com/InoshMatheesha/MooDeX"
                                       RequestNavigate="Hyperlink_RequestNavigate"
                                       Foreground="#7C6FCD">
                                github.com/InoshMatheesha/MooDeX
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Click="GitHubButton_Click"
                            VerticalAlignment="Center"
                            Padding="16,8"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                <Setter Property="BorderBrush" Value="#2A2A3E"/>
                                <Setter Property="Foreground" Value="#A0A0C0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#7C6FCD"/>
                                        <Setter Property="Foreground" Value="#BB86FC"/>
                                        <Setter Property="Background" Value="#12100E"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Github"
                                                     Width="15" Height="15"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0"/>
                            <TextBlock Text="Open GitHub" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- ══════════════════════════════
             Footer
        ══════════════════════════════ -->
        <Border Grid.Row="1"
                BorderBrush="#16162A"
                BorderThickness="0,1,0,0"
                Padding="40,12,40,14">
            <TextBlock FontSize="12" Foreground="#3A3A55" VerticalAlignment="Center">
                <Run Text="MooDeX" FontWeight="SemiBold"/>
                <Run Text=" · v1.3"/>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
