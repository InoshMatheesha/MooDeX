<Window x:Class="MooDeX_New_Version_1._0.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="MooDeX — Update Available"
        Width="520" Height="420"
        MinWidth="420" MinHeight="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Outer border provides the rounded-corner drop-shadow card appearance -->
    <Border CornerRadius="16"
            Background="#1A1C24"
            BorderBrush="#2A2A2A"
            BorderThickness="1"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Title bar / header -->
                <RowDefinition Height="Auto"/>   <!-- Version + date -->
                <RowDefinition Height="*"/>      <!-- Release notes (scrollable) -->
                <RowDefinition Height="Auto"/>   <!-- Progress bar -->
                <RowDefinition Height="Auto"/>   <!-- Status text -->
                <RowDefinition Height="Auto"/>   <!-- Action buttons -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════
                 ROW 0 — HEADER
                 Custom title bar with icon, title, and close button.
                 MouseLeftButtonDown enables window dragging.
            ═══════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Kind="Update"
                                         Width="28" Height="28"
                                         Foreground="#BB86FC"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"/>

                <TextBlock Grid.Column="1"
                           Text="Update Available"
                           FontSize="22" FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        Style="{StaticResource MaterialDesignIconButton}"
                        Width="32" Height="32"
                        Click="CloseButton_Click"
                        ToolTip="Close">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="#808080"/>
                </Button>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════
                 ROW 1 — VERSION + DATE
            ═══════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <Border Background="#2D1F5E" CornerRadius="8" Padding="10,5">
                    <TextBlock x:Name="VersionText"
                               Text="v1.0.0"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="#BB86FC"/>
                </Border>
                <TextBlock x:Name="DateText"
                           Text=""
                           FontSize="13"
                           Foreground="#8A8A8A"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════
                 ROW 2 — RELEASE NOTES (scrollable)
                 Displayed in a rounded card to visually separate the notes.
            ═══════════════════════════════════════════════════════ -->
            <Border Grid.Row="2"
                    Background="#12131A"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,0,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="ReleaseNotesText"
                               Text="Loading release notes..."
                               FontSize="13.5"
                               Foreground="#CCCCCC"
                               TextWrapping="Wrap"
                               LineHeight="22"/>
                </ScrollViewer>
            </Border>

            <!-- ═══════════════════════════════════════════════════════
                 ROW 3 — PROGRESS BAR
                 Hidden by default, shown during download.
            ═══════════════════════════════════════════════════════ -->
            <ProgressBar x:Name="DownloadProgressBar"
                         Grid.Row="3"
                         Height="6"
                         Minimum="0" Maximum="100" Value="0"
                         Foreground="#BB86FC"
                         Background="#2A2A2A"
                         Visibility="Collapsed"
                         Margin="0,0,0,8"/>

            <!-- ═══════════════════════════════════════════════════════
                 ROW 4 — STATUS TEXT
                 Shows "Downloading... 45%" or error messages.
            ═══════════════════════════════════════════════════════ -->
            <TextBlock x:Name="StatusText"
                       Grid.Row="4"
                       Text=""
                       FontSize="12"
                       Foreground="#8A8A8A"
                       Margin="0,0,0,16"
                       Visibility="Collapsed"/>

            <!-- ═══════════════════════════════════════════════════════
                 ROW 5 — ACTION BUTTONS
            ═══════════════════════════════════════════════════════ -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- "Later" button — subtle, secondary style -->
                <Button x:Name="LaterButton"
                        Grid.Column="1"
                        Content="Later"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="#8A8A8A"
                        FontSize="14"
                        Margin="0,0,10,0"
                        Click="LaterButton_Click"/>

                <!-- "Update Now" button — prominent, accented -->
                <Button x:Name="UpdateNowButton"
                        Grid.Column="2"
                        FontSize="14"
                        Padding="24,8"
                        Click="UpdateNowButton_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                            <Setter Property="Background" Value="#BB86FC"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10"/>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Download" Width="18" Height="18"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Update Now" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
